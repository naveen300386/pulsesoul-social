# Copy this file to .env and fill in only the platforms you have set up.
# A platform with blank values is simply skipped -- that is how you switch
# accounts on one at a time.
#
# .env is in .gitignore. Never commit real tokens.
# On GitHub these same names go in Settings -> Secrets and variables -> Actions.

# Where the rendered/ images are publicly readable. Instagram and Threads
# fetch the image from this URL rather than accepting uploaded bytes, so it
# has to be public. Everything else uploads directly and ignores this.
# GitHub Actions fills this in automatically; only set it for local runs --
# and change YOURNAME below to your GitHub username.
IMAGE_BASE_URL=https://raw.githubusercontent.com/YOURNAME/pulsesoul-social/main/rendered

# --- Meta (one app covers all three) ---------------------------------------
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
THREADS_USER_ID=
THREADS_TOKEN=

# --- Free, no review, working in minutes -----------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TOKEN=

# --- Needs approval, set up last -------------------------------------------
LINKEDIN_TOKEN=
LINKEDIN_ORG_ID=
PINTEREST_TOKEN=
PINTEREST_BOARD_ID=
